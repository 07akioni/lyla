{
  "name": "@lylajs/my",
  "version": "2.2.0",
  "scripts": {
    "check-type": "tsc -p tsconfig.cjs.json --noEmit",
    "build": "rm -rf es lib dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "es",
    "lib",
    "dist"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "dependencies": {
    "@lylajs/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.21.7",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
