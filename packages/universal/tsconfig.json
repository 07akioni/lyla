{
  "compilerOptions": {
    "declaration": true,
    "lib": ["ES2015", "DOM"],
    "target": "ES2017",
    "module": "CommonJS",
    "types": ["node"],
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
